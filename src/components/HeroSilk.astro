---
// Achtergrond-animatie voor de hero: trage, glasachtige "zijde" in merkkleuren,
// getekend door een WebGL2-fragmentshader (domain-warped noise + contour-
// randlichten + filmkorrel). Eigen implementatie; geen externe assets.
---

<div class="silk" data-silk aria-hidden="true">
  <canvas class="silk-canvas" data-silk-canvas></canvas>
  <!-- fallback / basiskleur zolang WebGL niet tekent -->
  <div class="silk-fallback"></div>
  <!-- zachte overlay voor leesbaarheid van de tekst -->
  <div class="silk-overlay"></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-silk]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-silk-canvas]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const VERT = `#version 300 es
  in vec2 aPos;
  void main() { gl_Position = vec4(aPos, 0.0, 1.0); }`;

  const FRAG = `#version 300 es
  precision highp float;
  uniform vec2 uRes;
  uniform float uTime;
  uniform float uScroll;
  out vec4 outColor;

  float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
  }
  float noise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
  }
  float fbm(vec2 p) {
    float v = 0.0, a = 0.5;
    mat2 rot = mat2(0.87, -0.48, 0.48, 0.87);
    for (int i = 0; i < 5; i++) {
      v += a * noise(p);
      p = rot * p * 2.02;
      a *= 0.5;
    }
    return v;
  }

  void main() {
    vec2 uv = (gl_FragCoord.xy - 0.5 * uRes) / min(uRes.x, uRes.y);
    // Scrollen "roert" de zijde: scrollpositie schuift de tijd vooruit
    float t = uTime * 0.038 + uScroll * 0.24;

    // Domain warping: ruis die zichzelf vervormt → trage zijde-stroming
    vec2 q = vec2(
      fbm(uv * 0.85 + vec2(0.0, t)),
      fbm(uv * 0.85 + vec2(5.2, 1.3) - t * 0.6)
    );
    vec2 r = vec2(
      fbm(uv * 0.85 + 2.0 * q + vec2(1.7, 9.2) + 0.30 * t),
      fbm(uv * 0.85 + 2.0 * q + vec2(8.3, 2.8) - 0.22 * t)
    );
    float f = fbm(uv * 0.85 + 1.8 * r);
    // Contrast: ruisveld uitrekken naar het volle 0..1-bereik
    f = smoothstep(0.22, 0.72, f);

    // Merkpalet: diep olijf → band-olijf → salie → licht zand
    vec3 deep  = vec3(0.075, 0.106, 0.063);
    vec3 olive = vec3(0.231, 0.290, 0.204);
    vec3 sage  = vec3(0.498, 0.580, 0.447);
    vec3 pale  = vec3(0.851, 0.816, 0.729);

    vec3 col = mix(deep, olive, smoothstep(0.0, 0.38, f));
    col = mix(col, sage, smoothstep(0.38, 0.72, f));
    col = mix(col, pale, smoothstep(0.72, 1.0, f) * 0.6);

    // Koperen randlichten langs de contouren van het veld — spaarzaam
    float band = abs(fract(f * 1.6 + r.x * 0.35) - 0.5);
    float w = fwidth(f) * 4.0 + 0.012;
    float line = smoothstep(0.05 + w, 0.0, band);
    vec3 copper = vec3(0.812, 0.494, 0.302);
    col += copper * line * (0.28 + 0.55 * smoothstep(0.3, 0.85, f));

    // Zachte vignet + filmkorrel tegen banding
    float vig = smoothstep(1.5, 0.3, length(uv));
    col *= mix(0.9, 1.0, vig);
    col += (hash(gl_FragCoord.xy + fract(uTime)) - 0.5) * 0.02;

    outColor = vec4(col, 1.0);
  }`;

  function start() {
    if (!canvas || !root) return;
    const gl = canvas.getContext('webgl2', { antialias: false, alpha: false });
    if (!gl) return; // fallback-div blijft zichtbaar

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'uRes');
    const uTime = gl.getUniformLocation(prog, 'uTime');
    const uScroll = gl.getUniformLocation(prog, 'uScroll');
    // Gedempte scrollwaarde zodat de zijde vloeiend meebeweegt, niet schokt
    let scrollSmooth = 0;

    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    const resize = () => {
      const w = Math.round(root.clientWidth * dpr);
      const h = Math.round(root.clientHeight * dpr);
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
      }
    };
    resize();
    window.addEventListener('resize', resize);

    let visible = true;
    let raf = 0;
    const t0 = performance.now();

    const frame = () => {
      resize();
      const scrollTarget = Math.min(window.scrollY / Math.max(window.innerHeight, 1), 1.6);
      scrollSmooth += (scrollTarget - scrollSmooth) * 0.06;
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uTime, (performance.now() - t0) / 1000);
      gl.uniform1f(uScroll, reduce ? 0 : scrollSmooth);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      canvas.classList.add('is-ready');
      if (visible && !reduce) raf = requestAnimationFrame(frame);
    };

    // Buiten beeld of verborgen tabblad → pauzeren (accu)
    const io = new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !reduce) {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(frame);
      }
    });
    io.observe(root);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else if (visible && !reduce) raf = requestAnimationFrame(frame);
    });

    // Bij reduced-motion: één mooi stilstaand frame
    raf = requestAnimationFrame(frame);
  }

  start();
</script>

<style>
  .silk {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }
  .silk-canvas,
  .silk-fallback,
  .silk-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .silk-canvas {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .silk-canvas.is-ready {
    opacity: 1;
  }
  /* Fallback zonder WebGL: rustige merk-gradient */
  .silk-fallback {
    background:
      radial-gradient(90% 90% at 78% 22%, color-mix(in srgb, var(--sage) 55%, transparent), transparent 60%),
      radial-gradient(70% 80% at 15% 85%, color-mix(in srgb, var(--ochre) 22%, transparent), transparent 65%),
      linear-gradient(150deg, #22301d, var(--band) 55%, #17200f);
    z-index: -1;
  }
  /* Leesbaarheid: zachte donkere zone aan de tekstkant */
  .silk-overlay {
    background:
      linear-gradient(100deg, rgba(13, 18, 10, 0.42) 0%, rgba(13, 18, 10, 0.18) 45%, rgba(13, 18, 10, 0.02) 70%),
      linear-gradient(rgba(13, 18, 10, 0.06), rgba(13, 18, 10, 0.06));
  }
</style>
