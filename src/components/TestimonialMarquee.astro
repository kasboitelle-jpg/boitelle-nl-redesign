---
import { testimonials } from '../data/site';

// Twee rijen, tegengesteld schuivend. Rij 2 in omgekeerde volgorde zodat
// de rijen niet identiek ogen. Om-en-om een gevuld accent-kaartje.
const row1 = testimonials.map((t, i) => ({ t, filled: i % 2 === 1 }));
const row2 = [...testimonials].reverse().map((t, i) => ({ t, filled: i % 2 === 0 }));

// Elke rij tweemaal → naadloze loop. De tweede helft is een kloon (aria-hidden).
const build = (row: typeof row1) =>
  [...row, ...row].map((c, idx) => ({ ...c, clone: idx >= row.length }));

const rows = [
  { dir: 'left', cards: build(row1) },
  { dir: 'right', cards: build(row2) },
];
---

<div class="tm">
  {
    rows.map((row) => (
      <div class={`tm-row tm-${row.dir}`} data-marquee>
        <div class="tm-track">
          {row.cards.map(({ t, filled, clone }) => (
            <figure
              class:list={['tm-card', filled && 'filled']}
              aria-hidden={clone ? 'true' : undefined}
            >
              <span class="tm-mark" aria-hidden="true"></span>
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="tm-name">{t.name}</span>
                <span class="tm-role">{t.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  .tm {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 0.5rem + 0.6vw, 1.2rem);
  }

  .tm-row {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
  }

  .tm-track {
    display: flex;
    width: max-content;
    padding-block: 1rem;
    will-change: transform;
  }
  .tm-left .tm-track {
    animation: tm-left 48s linear infinite;
  }
  .tm-right .tm-track {
    animation: tm-right 62s linear infinite;
  }
  .tm-row:hover .tm-track,
  .tm-row:focus-within .tm-track {
    animation-play-state: paused;
  }

  @keyframes tm-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes tm-right {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  /* ---- Kaart ---- */
  .tm-card {
    flex: 0 0 clamp(15.5rem, 19vw, 19.5rem);
    margin-right: clamp(0.8rem, 0.5rem + 0.8vw, 1.35rem);
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 1rem + 0.7vw, 1.75rem);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: 0 16px 34px -26px rgba(0, 0, 0, 0.55);
    transition: transform 0.4s var(--ease);
  }
  .tm-card:hover {
    transform: translateY(-5px);
  }

  /* accentstreepje i.p.v. avatar/quote-cliché */
  .tm-mark {
    width: 2rem;
    height: 3px;
    border-radius: 3px;
    background: var(--terracotta);
    margin-bottom: 1rem;
  }

  .tm-card blockquote {
    margin: 0 0 1.15rem;
    font-family: var(--font-serif);
    font-size: clamp(1.02rem, 0.96rem + 0.35vw, 1.25rem);
    font-style: italic;
    line-height: 1.4;
    color: var(--ink);
    text-wrap: pretty;
  }
  .tm-card figcaption {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .tm-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.02rem;
    color: var(--ink);
  }
  .tm-role {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  /* Gevuld accent-kaartje: terracotta met lichte tekst */
  .tm-card.filled {
    background: var(--terracotta);
    box-shadow: 0 18px 44px -24px rgba(140, 45, 25, 0.7);
  }
  .tm-card.filled .tm-mark {
    background: var(--ochre);
  }
  .tm-card.filled blockquote,
  .tm-card.filled .tm-name {
    color: var(--cream);
  }
  .tm-card.filled .tm-role {
    color: color-mix(in srgb, var(--cream) 72%, transparent);
  }

  /* Minder beweging: één stilstaande, gewrapte rij met de unieke citaten */
  @media (prefers-reduced-motion: reduce) {
    .tm-row {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .tm-right {
      display: none;
    }
    .tm-left .tm-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      gap: 1.25rem;
    }
    .tm-card {
      margin-right: 0;
      flex-basis: clamp(18rem, 40vw, 24rem);
    }
    .tm-card[aria-hidden='true'] {
      display: none;
    }
  }
</style>
