---
// Cijfer-sectie: twee-tonige kop en drie feitelijke tellers over de
// organisatie. Twee standen: volledig (Waarom ons?) en compact (home).
import StatCounter from './StatCounter.astro';
import { stats } from '../data/site';

interface Props {
  /** Donkere openingszin van de kop. */
  title: string;
  /** Gedempte vervolgtekst in dezelfde kop. */
  muted: string;
  compact?: boolean;
}
const { title, muted, compact = false } = Astro.props;
---

<section class:list={['stats-showcase', compact && 'compact']}>
  <div class="container">
    <h2 class="show-heading reveal">
      {title}{' '}
      <span class="show-muted">{muted}</span>
    </h2>

    <div class="show-stats reveal reveal-hold">
      {stats.map((s) => <StatCounter value={s.value} suffix={s.suffix} label={s.label} />)}
    </div>
  </div>
</section>

<style>
  .stats-showcase {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .stats-showcase.compact {
    padding-block: clamp(2rem, 1.25rem + 2.5vw, 3.5rem);
  }

  /* Twee-tonige kop: donkere opening, gedempt vervolg in dezelfde regelval */
  .show-heading {
    font-size: clamp(1.5rem, 1.15rem + 1.7vw, 2.6rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    max-width: 30ch;
    margin-bottom: clamp(2.25rem, 1.5rem + 2.5vw, 4rem);
    text-wrap: pretty;
  }
  .show-muted {
    color: var(--muted);
    font-weight: 400;
  }

  .show-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 52rem;
  }
  /* Links uitgelijnd, zoals de kop erboven */
  .show-stats :global(.stat) {
    text-align: left;
  }

  @media (max-width: 640px) {
    .show-stats {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
