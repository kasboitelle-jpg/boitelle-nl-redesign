---
import { testimonials } from '../data/site';

// Per kaart: kleurvariant + nette-grid offset + scatter-transform.
// Scatterwaardes met de hand gecomponeerd naar het referentiebeeld:
// gedraaid (±14°), richting het midden geschoven, overlappend.
const cards = [
  {
    t: testimonials[0],
    variant: 'cream',
    lift: '0rem',
    scatter: { x: '34%', y: '14%', r: '-14deg', z: 1 },
  },
  {
    t: testimonials[1],
    variant: 'terracotta',
    lift: '-2.2rem',
    scatter: { x: '-14%', y: '36%', r: '10deg', z: 3 },
  },
  {
    t: testimonials[2],
    variant: 'sand',
    lift: '1.6rem',
    scatter: { x: '10%', y: '-30%', r: '-8deg', z: 4 },
  },
  {
    t: testimonials[3],
    variant: 'sage',
    lift: '-0.8rem',
    scatter: { x: '-36%', y: '-16%', r: '13deg', z: 2 },
  },
];
---

<div class="scatter" data-scatter>
  <div class="scatter-grid">
    {
      cards.map(({ t, variant, lift, scatter }, i) => (
        <figure
          class:list={['sc-card', variant]}
          data-card
          style={`--lift:${lift}; --sx:${scatter.x}; --sy:${scatter.y}; --sr:${scatter.r}; --sz:${scatter.z}; --i:${i}`}
        >
          <span class="sc-quote" aria-hidden="true">&ldquo;</span>
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <span class="sc-avatar" aria-hidden="true">{t.name.charAt(0)}</span>
            <span class="sc-person">
              <span class="sc-name">{t.name}</span>
              <span class="sc-role">{t.role}</span>
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<script>
  import { animate, stagger } from 'motion';

  const root = document.querySelector<HTMLElement>('[data-scatter]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !reduce) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));

    const scatterTransform = (el: HTMLElement) => {
      const s = el.style;
      return `translate(${s.getPropertyValue('--sx')}, ${s.getPropertyValue('--sy')}) rotate(${s.getPropertyValue('--sr')})`;
    };

    // Startstaat: verstrooid (inline, zodat er geen flits van de nette grid is)
    const toScatter = () => {
      cards.forEach((c) => {
        c.style.transform = scatterTransform(c);
      });
      root.classList.add('is-scattered');
    };

    const assemble = () => {
      root.classList.remove('is-scattered');
      cards.forEach((c, i) => {
        animate(
          c,
          { transform: [scatterTransform(c), 'translate(0%, 0%) rotate(0deg)'] },
          {
            delay: i * 0.14,
            type: 'spring',
            stiffness: 42,
            damping: 11,
            mass: 1.1,
          } as any
        );
      });
    };

    toScatter();

    let assembled = false;
    // Uitvouwen pas als de bovenkant van het blok ruim in beeld is
    // (boven 55% van de viewport): zo zie je de animatie echt gebeuren.
    const assembleIO = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !assembled) {
            assembled = true;
            assemble();
          }
        }
      },
      { rootMargin: '0px 0px -45% 0px', threshold: 0.01 }
    );
    assembleIO.observe(root);

    // Reset pas wanneer het blok volledig onder beeld verdwenen is, zodat
    // de kaarten nooit zichtbaar terugspringen naar de scatter-stand.
    const resetIO = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting && assembled && entry.boundingClientRect.top > 0) {
            assembled = false;
            toScatter();
          }
        }
      },
      { threshold: 0 }
    );
    resetIO.observe(root);
  }
</script>

<style>
  .scatter {
    /* ruimte zodat gedraaide/geschoven kaarten niet klippen */
    padding-block: 1.5rem;
  }

  .scatter-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 0.6rem + 1vw, 1.6rem);
    max-width: 56rem;
    margin-inline: auto;
  }

  .sc-card {
    position: relative;
    z-index: var(--sz, 1);
    margin: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(1.4rem, 1.1rem + 0.9vw, 2rem);
    border-radius: var(--radius-lg);
    /* nette-staat: licht verspringend zoals de video */
    translate: 0 var(--lift, 0);
    box-shadow: 0 22px 45px -22px rgba(0, 0, 0, 0.5);
    will-change: transform;
  }

  /* Zonder JS of met reduced-motion staat alles gewoon netjes;
     de scatter-start zet JS zelf via inline transform. */

  .sc-quote {
    font-family: var(--font-serif);
    font-size: 2.6rem;
    line-height: 0.65;
    opacity: 0.45;
  }
  .sc-card blockquote {
    margin: 0.55rem 0 1.3rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 0.98rem + 0.4vw, 1.3rem);
    line-height: 1.42;
    text-wrap: pretty;
  }
  .sc-card figcaption {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .sc-avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: 50%;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.05rem;
  }
  .sc-person {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .sc-name {
    font-weight: 600;
    font-size: 0.98rem;
  }
  .sc-role {
    font-size: 0.85rem;
  }

  /* ---- Kleurvarianten (merk-pastelmix, zoals de video) ---- */
  .sc-card.cream {
    background: var(--card);
    color: var(--ink);
  }
  .sc-card.cream .sc-quote { color: var(--terracotta); }
  .sc-card.cream .sc-avatar { background: var(--terracotta-tint); color: var(--terracotta-dark); }
  .sc-card.cream .sc-role { color: var(--muted); }

  .sc-card.terracotta {
    background: var(--terracotta);
    color: var(--cream);
  }
  .sc-card.terracotta .sc-quote { color: var(--ochre); opacity: 0.8; }
  .sc-card.terracotta .sc-avatar { background: color-mix(in srgb, var(--cream) 22%, transparent); color: var(--cream); }
  .sc-card.terracotta .sc-role { color: color-mix(in srgb, var(--cream) 72%, transparent); }

  .sc-card.sand {
    background: var(--sand);
    color: var(--ink);
  }
  .sc-card.sand .sc-quote { color: var(--terracotta); }
  .sc-card.sand .sc-avatar { background: #fff; color: var(--terracotta-dark); }
  .sc-card.sand .sc-role { color: var(--muted); }

  .sc-card.sage {
    background: var(--sage-tint);
    color: var(--ink);
  }
  .sc-card.sage .sc-quote { color: var(--sage-deep); }
  .sc-card.sage .sc-avatar { background: #fff; color: var(--sage-deep); }
  .sc-card.sage .sc-role { color: var(--muted); }

  @media (max-width: 720px) {
    .scatter-grid {
      grid-template-columns: 1fr;
    }
    .sc-card {
      translate: 0 0;
    }
  }
</style>
