---
interface Props {
  value: number;
  suffix?: string;
  label: string;
}
const { value, suffix = '', label } = Astro.props;
---

<div class="stat">
  <div class="stat-value">
    <span data-counter data-value={value}>{value}</span><span class="stat-suffix">{suffix}</span>
  </div>
  <p class="stat-label">{label}</p>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('[data-counter]');

  const run = (el: HTMLElement) => {
    const target = Number(el.dataset.value || '0');
    if (reduce) {
      el.textContent = String(target);
      return;
    }
    el.textContent = '0';
    // Traag genoeg om samen te lopen met de draw-in van de verzuimgrafiek:
    // de cijfers tellen nog door terwijl de lijn zich tekent (één scène).
    const duration = 2800;
    let start: number | null = null;
    const step = (t: number) => {
      if (start === null) start = t;
      const p = Math.min((t - start) / duration, 1);
      // easeOutQuad: blijft langer zichtbaar in beweging dan easeOutCubic
      const eased = 1 - Math.pow(1 - p, 2);
      el.textContent = String(Math.round(eased * target));
      if (p < 1) requestAnimationFrame(step);
      else el.textContent = String(target);
    };
    requestAnimationFrame(step);
  };

  if (!('IntersectionObserver' in window)) {
    counters.forEach(run);
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            run(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.5 }
    );
    counters.forEach((c) => io.observe(c));
  }
</script>

<style>
  .stat {
    text-align: center;
  }
  .stat-value {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.75rem, 1.8rem + 3.6vw, 4.25rem);
    line-height: 1;
    color: var(--terracotta);
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: baseline;
  }
  .stat-suffix {
    color: var(--sage);
  }
  .stat-label {
    margin-top: 0.6rem;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--muted);
  }
</style>
