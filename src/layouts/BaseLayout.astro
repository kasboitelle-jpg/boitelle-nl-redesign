---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Verberg pagina voor zoekmachines (bijv. Opleidingen, dat niet in het menu staat). */
  noindex?: boolean;
}

const {
  title,
  description = 'Boitelle HR Proactief helpt organisaties verzuim en verloop duurzaam verminderen met een datagedreven aanpak.',
  noindex = false,
} = Astro.props;

const fullTitle = title
  ? `${title} | ${site.name} | ${site.suffix}`
  : `${site.name} | ${site.suffix}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.boitelle.nl');
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Markeer dat JS aanstaat — pas dán worden reveal-elementen verborgen.
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#faf5ee" />
  </head>
  <body>
    <a href="#main" class="skip-link">Doorgaan naar hoofdinhoud</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal: voegt .is-visible toe zodra een element in beeld komt.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('.reveal');

      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -4rem;
        z-index: 200;
        padding: 0.6rem 1rem;
        background: var(--ink);
        color: #fff;
        border-radius: 8px;
        transition: top 0.2s ease;
      }
      .skip-link:focus {
        top: 1rem;
      }
    </style>
  </body>
</html>
