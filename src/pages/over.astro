---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import LogoStrip from '../components/LogoStrip.astro';

// Accentkleur + streek-variant per rij (zelfde handgetekende taal als de
// klantnamen onderaan)
const accents = ['--terracotta', '--ochre', '--sage-deep', '--terracotta-dark'];
const strokes = ['M2,9 Q26,4.5 50,7.5 T98,6', 'M2,6.5 Q30,9.5 54,6 T98,8'];

// Feitelijke informatie, geen verkoopargumenten. Alleen gegevens die ook
// elders op de site of in de oorspronkelijke tekst staan.
const rows = [
  {
    no: '01',
    title: 'Achtergrond',
    body: 'Mark Boitelle is psycholoog (NIP) en directeur van Boitelle Opleidingen B.V. in Nijmegen. Hij houdt zich al ruim twintig jaar bezig met verzuim en verloop in organisaties.',
  },
  {
    no: '02',
    title: 'Werkwijze',
    body: 'Uitgangspunt zijn de verzuimgegevens van een team of afdeling. Leidinggevenden leren die gegevens te lezen, signalen vroeg te herkennen en verzuimgesprekken te voeren. In de loop der jaren werkte Boitelle met meer dan 400 leidinggevenden en 200 teams.',
  },
  {
    no: '03',
    title: 'Docenten',
    body: 'Alle docenten van Boitelle Opleidingen zijn NIP-psychologen. Zij zijn daarnaast parttime verbonden aan Nederlandse universiteiten en hogescholen.',
  },
  {
    no: '04',
    title: 'Locatie',
    body: 'Bijeenkomsten vinden meestal plaats bij de organisatie zelf. Waar nodig wordt uitgeweken naar een externe locatie van de Radboud Universiteit.',
  },
];
---

<BaseLayout
  title="Over"
  description="Over drs. Mark Boitelle, psycholoog NIP, en Boitelle HR Proactief in Nijmegen: achtergrond, werkwijze, docenten en locatie."
>
  <!-- PAGE HEADER -->
  <section class="page-hero">
    <div class="container container-narrow text-center">
      <Reveal>
        <span class="eyebrow mx-auto">Over</span>
        <h1>Mark Boitelle</h1>
        <p class="lead">
          Psycholoog en opleider. Met Boitelle HR Proactief begeleidt hij
          leidinggevenden en teams bij vraagstukken rond verzuim en verloop.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- INFORMATIE: redactionele index in plaats van een kaartjes-grid -->
  <section class="section reasons">
    <div class="container">
      <div class="reasons-list">
        {
          rows.map((r, i) => (
            <article class="reason-row reveal" style={`--accent: var(${accents[i % accents.length]})`}>
              <span class="reason-no" aria-hidden="true">{r.no}</span>
              <h3 class="reason-title">
                <span class="reason-title-inner">
                  {r.title}
                  <svg class="stroke" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
                    <path
                      d={strokes[i % strokes.length]}
                      pathLength="1"
                      fill="none"
                      stroke-width="3"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
              </h3>
              <p>{r.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ORGANISATIES -->
  <section class="section trust">
    <div class="container">
      <LogoStrip />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .page-hero .eyebrow {
    display: inline-flex;
    margin-bottom: 1.25rem;
  }
  .page-hero h1 {
    margin-bottom: 1.25rem;
  }
  .page-hero .lead {
    margin-inline: auto;
    max-width: 54ch;
  }

  .reasons-list {
    border-top: 1px solid var(--line);
  }
  /* Zigzag: even rijen spiegelen, nummers steeds aan de buitenrand —
     het oog weeft naar beneden in plaats van vier keer hetzelfde rijtje */
  .reason-row {
    display: grid;
    grid-template-columns: clamp(5rem, 3rem + 6vw, 8.5rem) minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: clamp(1.25rem, 0.75rem + 2vw, 3rem);
    align-items: start;
    padding-block: clamp(2rem, 1.4rem + 2.2vw, 3.5rem);
    padding-inline: clamp(0.75rem, 1.5vw, 1.5rem);
    margin-inline: calc(-1 * clamp(0.75rem, 1.5vw, 1.5rem));
    border-bottom: 1px solid var(--line);
    transition: background-color 0.45s ease;
  }
  .reason-row:hover {
    background-color: color-mix(in srgb, var(--accent) 5%, transparent);
  }
  .reason-row:nth-child(even) {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr) clamp(5rem, 3rem + 6vw, 8.5rem);
  }
  .reason-row:nth-child(even) p {
    order: 1;
  }
  .reason-row:nth-child(even) .reason-title {
    order: 2;
  }
  .reason-row:nth-child(even) .reason-no {
    order: 3;
    justify-self: end;
  }
  .reason-no {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 2rem + 4vw, 5.75rem);
    font-weight: 500;
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: color-mix(in srgb, var(--accent) 50%, var(--cream));
    transition: color 0.35s ease;
  }
  .reason-row:hover .reason-no {
    color: var(--accent);
  }
  .reason-title {
    margin: 0;
    font-size: clamp(1.55rem, 1.25rem + 1.5vw, 2.25rem);
  }
  .reason-title-inner {
    position: relative;
    display: inline-block;
    padding-bottom: 0.14em;
  }
  .reason-row p {
    margin: 0;
    max-width: 55ch;
    color: var(--ink-soft);
  }

  /* Merkstreek onder de titel: tekent zich zodra de rij in beeld komt,
     dikt aan bij hover */
  .stroke {
    position: absolute;
    left: -1%;
    bottom: -0.04em;
    width: 102%;
    height: 0.3em;
    overflow: visible;
    transform-origin: bottom;
    transition: transform 0.25s var(--ease);
  }
  .reason-row:hover .stroke {
    transform: scaleY(1.3);
  }
  .stroke path {
    stroke: var(--accent);
    stroke-dasharray: 1 1.2;
  }
  :global(html.js) .stroke path {
    stroke-dashoffset: 1.08;
    transition: stroke-dashoffset 0.55s var(--ease) 0.4s;
  }
  :global(html.js) .reason-row.is-visible .stroke path {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .stroke path {
      stroke-dashoffset: 0;
      transition: none;
    }
    .reason-row:hover .stroke {
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .reason-row,
    .reason-row:nth-child(even) {
      grid-template-columns: auto 1fr;
      row-gap: 0.85rem;
    }
    .reason-row:nth-child(even) p,
    .reason-row:nth-child(even) .reason-title,
    .reason-row:nth-child(even) .reason-no {
      order: 0;
      justify-self: start;
    }
    .reason-row p {
      grid-column: 1 / -1;
    }
  }
</style>
