---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import { site } from '../data/site';

const facts = [
  { label: 'Looptijd', value: 'circa 6 maanden' },
  { label: 'Groepsgrootte', value: '1 tot 10 deelnemers' },
  { label: 'Kennismaking', value: 'op locatie' },
  { label: 'Betaling', value: 'binnen 30 dagen' },
];
---

<BaseLayout
  title="Opleidingen"
  description="Opleiding ‘Datagedreven grip op verzuim’ voor leidinggevenden."
  noindex={true}
>
  <section class="page-hero left">
    <div class="container">
      <Reveal>
        <span class="eyebrow">Opleidingen</span>
        <h1>Datagedreven grip op verzuim</h1>
        <p class="sub">Beroepsopleiding voor leidinggevenden</p>
        <p class="lead">
          Een opleiding voor leidinggevenden over het terugdringen van verzuim
          binnen hun eigen team.
        </p>
      </Reveal>
    </div>
  </section>

  <section class="section">
    <div class="container opl-layout">
      <div class="opl-content prose">
        <section class="block reveal">
          <h3>Doel</h3>
          <p>
            De opleiding helpt leidinggevenden om verzuim binnen hun eigen team beter te
            herkennen, bespreekbaar te maken en terug te dringen.
          </p>
        </section>

        <section class="block reveal">
          <h3>Voor wie?</h3>
          <p>Deze opleiding is bedoeld voor:</p>
          <ul>
            <li>Direct leidinggevenden met verantwoordelijkheid voor verzuim binnen hun team.</li>
            <li>Managers met minimaal hbo werk- en denkniveau.</li>
          </ul>
        </section>

        <section class="block reveal">
          <h3>Opzet</h3>
          <p>
            De opleiding wordt per team verzorgd en sluit aan op de eigen werkpraktijk.
            De looptijd is circa 6 maanden. Het studiemateriaal is bij de opleiding
            inbegrepen.
          </p>
        </section>

        <section class="block reveal">
          <h3>Groepsgrootte</h3>
          <p>De groepsgrootte varieert van 1 tot maximaal 10 deelnemers per groep.</p>
        </section>

        <section class="block reveal">
          <h3>Kennismakingsgesprek</h3>
          <p>
            Voorafgaand aan de opleiding vindt een kennismakingsgesprek op locatie plaats.
            Daarin worden de leerdoelen besproken en wordt bekeken of de opleiding
            passend is voor de deelnemer en de organisatie.
          </p>
        </section>

        <section class="block reveal">
          <h3>Factuur</h3>
          <p>Bij de start van het opleidingstraject ontvangt de opdrachtgever de factuur. De factuur bevat het totaalbedrag van de opleiding en dient binnen 30 dagen te worden voldaan.</p>
        </section>
      </div>

      <!-- Snelle feiten + contact -->
      <aside class="opl-aside">
        <div class="facts-card">
          <p class="facts-title">In het kort</p>
          <dl>
            {
              facts.map((f) => (
                <div class="fact">
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <div class="aside-contact">
            <p class="facts-title">Meer informatie</p>
            <p>{site.director}</p>
            <a href={site.phoneHref} class="aside-phone">{site.phone}</a>
            <a href="#contact" class="btn aside-btn">Contact</a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(1rem, 0.5rem + 2vw, 2rem);
  }
  .page-hero .eyebrow {
    margin-bottom: 1.25rem;
  }
  .page-hero h1 {
    margin-bottom: 0.5rem;
  }
  .sub {
    font-size: 1.05rem;
    color: var(--sage-deep);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }
  .page-hero .lead {
    max-width: 60ch;
  }

  .opl-layout {
    display: grid;
    grid-template-columns: 1fr 19rem;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    align-items: start;
  }
  .opl-content {
    max-width: 70ch;
  }
  .block {
    padding-top: 2rem;
    margin-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .opl-content > :global(.block:first-child) {
    padding-top: 0;
    margin-top: 0;
    border-top: none;
  }
  .block h3 {
    margin-top: 0;
  }

  .opl-aside {
    position: sticky;
    top: 6.5rem;
  }
  .facts-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }
  .facts-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .facts-card dl {
    display: flex;
    flex-direction: column;
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .fact:last-child {
    border-bottom: none;
  }
  .fact dt {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .fact dd {
    margin: 0;
    color: var(--ink);
    font-weight: 500;
  }
  .aside-contact {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .aside-contact p {
    color: var(--ink-soft);
  }
  .aside-phone {
    display: inline-block;
    margin-top: 0.35rem;
    font-weight: 600;
    color: var(--terracotta);
  }
  .aside-btn {
    margin-top: 1.25rem;
    width: 100%;
  }

  @media (max-width: 900px) {
    .opl-layout {
      grid-template-columns: 1fr;
    }
    .opl-aside {
      position: static;
      order: -1;
    }
  }
</style>
