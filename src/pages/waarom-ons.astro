---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import LogoStrip from '../components/LogoStrip.astro';
import { testimonials } from '../data/site';

// Klantstem als bewijs vóór de vier redenen (Erik, directeur ICT-bedrijf)
const quote = testimonials[2];

// Accentkleur + streek-variant per rij (zelfde handgetekende taal als de
// klantnamen op de homepagina)
const accents = ['--terracotta', '--ochre', '--sage-deep', '--terracotta-dark'];
const strokes = ['M2,9 Q26,4.5 50,7.5 T98,6', 'M2,6.5 Q30,9.5 54,6 T98,8'];

const reasons = [
  {
    no: '01',
    title: 'Ruim twintig jaar bewezen ervaring',
    body: 'Met meer dan twintig jaar ervaring helpen wij organisaties hun verzuim te verminderen. Onze aanpak werkt op alle niveaus en leidt tot concrete resultaten, zichtbaar in samenwerkingen met onder andere VGZ, Dichterbij, Wageningen Universiteit en de Politie Academie.',
  },
  {
    no: '02',
    title: 'Stevig verankerd in de praktijk',
    body: 'In de loop der jaren werkten wij met meer dan 400 leidinggevenden en 200 teams. Steeds met een sterke aansluiting op de dagelijkse praktijk en met actuele, direct toepasbare kennis.',
  },
  {
    no: '03',
    title: 'Kennis die actueel blijft',
    body: 'Onze docenten zijn parttime verbonden aan Nederlandse universiteiten en hogescholen. Daardoor blijven hun kennis en vaardigheden voortdurend up-to-date.',
  },
  {
    no: '04',
    title: 'Het liefst bij u op locatie',
    body: 'Onze bijeenkomsten vinden vaak op locatie plaats. Dat is logistiek praktisch en zorgt voor een directe aansluiting op de dagelijkse praktijk. Waar nodig wijken we uit naar een externe locatie van de Radboud Universiteit.',
  },
];
---

<BaseLayout
  title="Waarom ons?"
  description="Waarom organisaties met Boitelle HR Proactief samenwerken: ruim twintig jaar ervaring, honderden teams en een aanpak die stevig in de praktijk staat."
>
  <!-- PAGE HEADER -->
  <section class="page-hero">
    <div class="container container-narrow text-center">
      <Reveal>
        <span class="eyebrow mx-auto">Waarom ons?</span>
        <h1>Daarom kiezen klanten voor ons</h1>
        <p class="lead">
          Elke organisatie is anders, maar één ding is overal hetzelfde: verzuim vraagt
          om een aanpak die werkt. Dit is waarom klanten graag met ons samenwerken.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- KLANT-QUOTE: klantstem als bewijs vóór de vier redenen -->
  <section class="quote-section">
    <div class="container">
      <figure class="pull-quote reveal">
        <span class="pq-mark" aria-hidden="true">&ldquo;</span>
        <blockquote>
          Verzuim is <span class="pq-accent">spectaculair gedaald.<svg
              class="stroke"
              viewBox="0 0 100 12"
              preserveAspectRatio="none"
              aria-hidden="true"
            ><path
                d={strokes[0]}
                pathLength="1"
                fill="none"
                stroke-width="3.2"
                stroke-linecap="round"></path></svg></span> Een heel leuk traject.
        </blockquote>
        <figcaption>
          <span class="pq-name">{quote.name}</span>
          <span class="pq-sep" aria-hidden="true">·</span>
          <span class="pq-role">{quote.role}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- REASONS: redactionele index in plaats van een kaartjes-grid -->
  <section class="section reasons">
    <div class="container">
      <div class="reasons-list">
        {
          reasons.map((r, i) => (
            <article class="reason-row reveal" style={`--accent: var(${accents[i % accents.length]})`}>
              <span class="reason-no" aria-hidden="true">{r.no}</span>
              <h3 class="reason-title">
                <span class="reason-title-inner">
                  {r.title}
                  <svg class="stroke" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
                    <path
                      d={strokes[i % strokes.length]}
                      pathLength="1"
                      fill="none"
                      stroke-width="3"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
              </h3>
              <p>{r.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="section trust">
    <div class="container">
      <LogoStrip />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .page-hero .eyebrow {
    display: inline-flex;
    margin-bottom: 1.25rem;
  }
  .page-hero h1 {
    margin-bottom: 1.25rem;
  }
  .page-hero .lead {
    margin-inline: auto;
    max-width: 54ch;
  }

  /* Pull-quote: klantstem groot in serif, met merkstreek onder de kern */
  .quote-section {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 5rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .pull-quote {
    margin: 0 auto;
    text-align: center;
  }
  .pq-mark {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 2.2rem + 3vw, 5rem);
    line-height: 0.4;
    color: var(--terracotta);
    opacity: 0.5;
    margin-bottom: 0.35em;
  }
  .pull-quote blockquote {
    margin: 0 auto;
    max-width: 36ch;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.7rem, 1.3rem + 2.2vw, 3rem);
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
  }
  .pq-accent {
    position: relative;
    display: inline-block;
    white-space: nowrap;
    padding-bottom: 0.08em;
  }
  .pq-accent .stroke {
    position: absolute;
    left: -1%;
    bottom: -0.05em;
    width: 102%;
    height: 0.26em;
    overflow: visible;
  }
  .pq-accent .stroke path {
    stroke: var(--terracotta);
    stroke-dasharray: 1 1.2;
  }
  :global(html.js) .pq-accent .stroke path {
    stroke-dashoffset: 1.08;
    transition: stroke-dashoffset 0.6s var(--ease) 0.5s;
  }
  :global(html.js) .pull-quote.is-visible .pq-accent .stroke path {
    stroke-dashoffset: 0;
  }
  .pull-quote figcaption {
    margin-top: 1.5rem;
    font-size: var(--fs-small);
  }
  .pq-name {
    font-weight: 600;
    color: var(--ink);
  }
  .pq-sep {
    margin-inline: 0.4em;
    color: var(--ochre);
  }
  .pq-role {
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .pq-accent .stroke path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }

  .reasons-list {
    border-top: 1px solid var(--line);
  }
  /* Zigzag: even rijen spiegelen, nummers steeds aan de buitenrand —
     het oog weeft naar beneden in plaats van vier keer hetzelfde rijtje */
  .reason-row {
    display: grid;
    grid-template-columns: clamp(5rem, 3rem + 6vw, 8.5rem) minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: clamp(1.25rem, 0.75rem + 2vw, 3rem);
    align-items: start;
    padding-block: clamp(2rem, 1.4rem + 2.2vw, 3.5rem);
    padding-inline: clamp(0.75rem, 1.5vw, 1.5rem);
    margin-inline: calc(-1 * clamp(0.75rem, 1.5vw, 1.5rem));
    border-bottom: 1px solid var(--line);
    transition: background-color 0.45s ease;
  }
  .reason-row:hover {
    background-color: color-mix(in srgb, var(--accent) 5%, transparent);
  }
  .reason-row:nth-child(even) {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr) clamp(5rem, 3rem + 6vw, 8.5rem);
  }
  .reason-row:nth-child(even) p {
    order: 1;
  }
  .reason-row:nth-child(even) .reason-title {
    order: 2;
  }
  .reason-row:nth-child(even) .reason-no {
    order: 3;
    justify-self: end;
  }
  .reason-no {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 2rem + 4vw, 5.75rem);
    font-weight: 500;
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: color-mix(in srgb, var(--accent) 50%, var(--cream));
    transition: color 0.35s ease;
  }
  .reason-row:hover .reason-no {
    color: var(--accent);
  }
  .reason-title {
    margin: 0;
    font-size: clamp(1.55rem, 1.25rem + 1.5vw, 2.25rem);
  }
  .reason-title-inner {
    position: relative;
    display: inline-block;
    padding-bottom: 0.14em;
  }
  .reason-row p {
    margin: 0;
    max-width: 55ch;
    color: var(--ink-soft);
  }

  /* Merkstreek onder de titel: tekent zich zodra de rij in beeld komt,
     dikt aan bij hover */
  .stroke {
    position: absolute;
    left: -1%;
    bottom: -0.04em;
    width: 102%;
    height: 0.3em;
    overflow: visible;
    transform-origin: bottom;
    transition: transform 0.25s var(--ease);
  }
  .reason-row:hover .stroke {
    transform: scaleY(1.3);
  }
  .stroke path {
    stroke: var(--accent);
    stroke-dasharray: 1 1.2;
  }
  :global(html.js) .stroke path {
    stroke-dashoffset: 1.08;
    transition: stroke-dashoffset 0.55s var(--ease) 0.4s;
  }
  :global(html.js) .reason-row.is-visible .stroke path {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .stroke path {
      stroke-dashoffset: 0;
      transition: none;
    }
    .reason-row:hover .stroke {
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .reason-row,
    .reason-row:nth-child(even) {
      grid-template-columns: auto 1fr;
      row-gap: 0.85rem;
    }
    .reason-row:nth-child(even) p,
    .reason-row:nth-child(even) .reason-title,
    .reason-row:nth-child(even) .reason-no {
      order: 0;
      justify-self: start;
    }
    .reason-row p {
      grid-column: 1 / -1;
    }
  }
</style>
